+        ),
+        (
+            EthereumHardfork::Prague.boxed(),
+            ForkCondition::Timestamp(1748930400),
+        ),
+        // Osaka (Fusaka CL) - enables BLS precompiles (EIP-2537) and PeerDAS (EIP-7594)
