+/// Create a test header with default values
+fn create_test_header() -> Header {
+    Header {
+        parent_hash: B256::ZERO,
+        ommers_hash: B256::ZERO,
+        beneficiary: Address::ZERO,
+        state_root: B256::ZERO,
+        transactions_root: B256::ZERO,
