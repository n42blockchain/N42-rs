+#[test]
+fn test_seal_hash_deterministic() {
+    let header = create_test_header();
+    let hash1 = seal_hash(&header);
+    let hash2 = seal_hash(&header);
+    assert_eq!(hash1, hash2, "seal_hash should be deterministic");
+}
